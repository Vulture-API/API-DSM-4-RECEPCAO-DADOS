INGEST_MQTT_HOST=localhost
INGEST_MQTT_PORT=1883
INGEST_MQTT_USERNAME=
INGEST_MQTT_PASSWORD=
INGEST_MQTT_TOPIC=estacoes/+/dados
INGEST_MQTT_CLIENT_ID=station-ingest-01
INGEST_MQTT_KEEPALIVE=60
INGEST_MQTT_MAX_QUEUED_INCOMING_MESSAGES=50000
INGEST_MQTT_TLS=false
INGEST_MQTT_TLS_CA_FILE=
INGEST_MQTT_TLS_CERT_FILE=
INGEST_MQTT_TLS_KEY_FILE=
INGEST_MQTT_TLS_INSECURE=false

INGEST_REDIS_URL=redis://localhost:6379/0
INGEST_REDIS_STREAM=telemetry:ingest
INGEST_REDIS_MAX_CONNECTIONS=20
INGEST_REDIS_SOCKET_TIMEOUT_SECONDS=5

INGEST_QUEUE_MAX_SIZE=50000
INGEST_BATCH_SIZE=500
INGEST_FLUSH_INTERVAL_MS=50
INGEST_MAX_PAYLOAD_BYTES=262144
INGEST_RETENTION_DAYS=7
INGEST_RETENTION_INTERVAL_SECONDS=60
INGEST_RETRY_INITIAL_SECONDS=0.25
INGEST_RETRY_MAX_SECONDS=30
INGEST_SHUTDOWN_TIMEOUT_SECONDS=30

INGEST_LOG_LEVEL=INFO
INGEST_METRICS_INTERVAL_SECONDS=30
